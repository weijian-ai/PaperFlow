# PaperFlow 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
PAPERFLOW_HOST=127.0.0.1
PAPERFLOW_PORT=7437

# ── Logging ───────────────────────────────────────────────────
PAPERFLOW_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
PAPERFLOW_LOG_FILE=~/.paperflow/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
PAPERFLOW_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# PAPERFLOW_CONFIG=~/.paperflow/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# provider 二选一：
#   anthropic = 官方 Anthropic SDK（/v1/messages 协议）
#   openai    = 任意 OpenAI 兼容网关（/v1/chat/completions 协议）
PAPERFLOW_LLM_PROVIDER=anthropic
PAPERFLOW_LLM_DEFAULT_MODEL=claude-sonnet-4-6
PAPERFLOW_MAX_STEPS=20

# Anthropic 官方（provider=anthropic 时使用）
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com


# ── 示例：DeepSeek 官方（OpenAI 兼容）──
# PAPERFLOW_LLM_PROVIDER=openai
# PAPERFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
# PAPERFLOW_LLM_API_KEY=sk-...
# PAPERFLOW_LLM_DEFAULT_MODEL=deepseek-chat
